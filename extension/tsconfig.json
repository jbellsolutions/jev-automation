{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "chrome",
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
