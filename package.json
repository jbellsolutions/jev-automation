{
  "name": "jev-voice-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Speak to your browser: live speech transcription + TypeSafe Jev decisions driving a Playwright-controlled Chromium in realtime.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "build:native": "sh scripts/build-native.sh",
    "stt:smoke": "tsx scripts/stt-smoke.ts",
    "build:app": "node scripts/build-app.mjs",
    "voice:test": "node --import tsx scripts/voice-test.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "bridge:smoke": "node --import tsx scripts/bridge-smoke.mjs",
    "app": "npm run build && npm run build:app && electron .",
    "app:run": "electron .",
    "app:fake": "npm run build && npm run build:app && JEV_AUTOLISTEN=1 electron . --remote-debugging-port=9223 --no-sandbox --use-fake-ui-for-media-stream --use-fake-device-for-media-stream --use-file-for-fake-audio-capture=${JEV_FAKE_WAV:-scratch/cats.wav}%noloop"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "express": "^5.2.1",
    "playwright": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "main": "dist/app/main.mjs"
}
