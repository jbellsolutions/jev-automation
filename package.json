{
  "name": "jev-voice-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Speak to your browser: live speech transcription + TypeSafe Jev decisions driving a Playwright-controlled Chromium in realtime.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "express": "^5.2.1",
    "playwright": "1.56.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
