# Get a key from the TypeSafe console (https://typesafe.ai). Without it the app
# still runs, but falls back to keyword heuristics instead of Jev decisions.
TYPESAFE_API_KEY=
# Optional: jev-latest (default), jev-preview, or a pinned version like jev-1.13.0
TYPESAFE_DEFAULT_MODEL=jev-latest

# Server
PORT=3000
# Live-view frames: device pixels per CSS pixel (2 = crisp on Retina/HiDPI) and JPEG quality
DEVICE_SCALE_FACTOR=2
JPEG_QUALITY=80
# Show the controlled Chromium window on your machine (false = headless, you still
# see it streamed inside the web app either way)
HEADLESS=true
# Page the controlled browser opens on start (falls back to the built-in
# http://localhost:3000/demo site if it can't be reached)
START_URL=https://www.google.com
# Optional: point at an existing Chromium/Chrome binary instead of the one
# installed by `npx playwright install chromium`
CHROMIUM_EXECUTABLE_PATH=
# Optional: extra Chromium switches, space separated (e.g. --proxy-server=http://proxy:8080)
CHROMIUM_ARGS=

# --- Jev assistant ---
# Shared secret the desktop app, Chrome bridge and MCP server present to the companion (openssl rand -hex 24)
JEV_TOKEN=
# Streaming transcription (Deepgram). Without it the web client falls back to the browser's Web Speech API.
DEEPGRAM_API_KEY=
# nova-3 (default) supports keyterm boosting; older models fall back to `keywords`
DEEPGRAM_MODEL=
# auto (default): Deepgram when keyed, falling back to Apple on-device (needs `npm run build:native`); or deepgram | apple
STT_PROVIDER=
# Milliseconds of silence after the last transcript before an utterance auto-flushes without an
# explicit stop. Long on purpose (15s default) so a mid-thought pause during dictation doesn't
# dispatch early — pressing stop is the normal way to end an utterance.
STT_GAP_MS=
ANTHROPIC_API_KEY=
# Hermes / Super Browser remote MCP. Leave blank to read ~/.super-browser/.mcp.json at runtime.
SUPER_BROWSER_URL=
SUPER_BROWSER_TOKEN=
DELEGATE_BUDGET_USD=1
# Local Hermes Agent API server (the brain): enable it in ~/.hermes/.env with API_SERVER_ENABLED=true and
# API_SERVER_KEY=<same value as here, 16+ chars>; the gateway serves it on 127.0.0.1:8642
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Voice out: JEV_TTS = elevenlabs | say | off (default: elevenlabs when the key is set, else say).
# ELEVENLABS_VOICE_ID defaults to Adam (pNInz6obpgDQGcFmaJgB); ELEVENLABS_TTS_MODEL to eleven_turbo_v2_5
# (eleven_flash_v2_5 is faster and flatter). Playback streams through ffplay when installed (brew install ffmpeg), else afplay.
JEV_TTS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=

# Model the voice conversation runs on (a Hermes provider model id, e.g. deepseek-v4.1-flash or
# glm-5.3-flash on Ollama Cloud); unset = Hermes' own default. Changing it starts a new conversation.
HERMES_VOICE_MODEL=
HERMES_VOICE_PROVIDER=

# Mac apps in front through cua-driver (the driver Hermes computer-use installs): JEV_MAC=off disables
# the surface; CUA_DRIVER points at the binary when it is not ~/.local/bin/cua-driver.
JEV_MAC=
CUA_DRIVER=
